{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "muse-server",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "packages/server/src/main.ts"
      ],
      "port": 7777
    },
    {
      "name": "muse-share",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "packages/server/bin/muse-launch.mjs",
        "--share"
      ],
      "port": 7777
    },
    {
      "name": "sound-audition",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "docs/sound-audition/serve.mjs"
      ],
      "port": 7790
    },
    {
      "name": "trial-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "../MuseDungeon-trial/trial-launch.mjs"
      ],
      "port": 7795
    }
  ]
}
